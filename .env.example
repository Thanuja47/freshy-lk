# -----------------------------------------------------------------------------
# Freshy.lk Environment Configuration Template
# All environment variables are validated in src/lib/env.ts
# -----------------------------------------------------------------------------

# App Core Configuration
# Public canonical base URL of the website
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Application environment (development | preview | production)
NEXT_PUBLIC_APP_ENV=development
# Enable mock demo mode for local UI testing without external DB/gateways (false in production)
DEMO_MODE=false
# Passcode for bypassing full auth during local demo testing
DEMO_ADMIN_PASSCODE=changeme-demo-passcode
# Secret key for HMAC token generation in demo mode (32+ chars)
DEMO_HMAC_SECRET=changeme-demo-hmac-secret-key-32-chars
# Timezone setting for date and cutoff calculations
TZ=Asia/Colombo

# Supabase & Database (Primary Storage)
# Supabase project public URL endpoint
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Supabase anonymous public client key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Supabase privileged service role secret key (server side only)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# PostgreSQL pooled connection string (used by Prisma client queries)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:6543/postgres?pgbouncer=true
# PostgreSQL direct connection string (used by Prisma schema migrations)
DIRECT_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Database Seeding Credentials
# Initial superadmin user email created during seed
SEED_ADMIN_EMAIL=admin@freshy.lk
# Initial superadmin user password created during seed
SEED_ADMIN_PASSWORD=ChangeMe123!

# PayHere Payment Gateway (Sri Lanka)
# PayHere gateway operating environment (sandbox | live)
PAYHERE_MODE=sandbox
# PayHere registered Merchant ID
PAYHERE_MERCHANT_ID=123456
# PayHere registered Merchant Secret Key
PAYHERE_MERCHANT_SECRET=your-payhere-secret

# Notifications & SMS / Email
# SMS Provider service name (e.g. notifylk)
SMS_PROVIDER=notifylk
# Notify.lk API User ID
NOTIFYLK_USER_ID=
# Notify.lk API Key
NOTIFYLK_API_KEY=
# Notify.lk Sender ID tag
NOTIFYLK_SENDER_ID=Freshy
# Resend Email service API key
RESEND_API_KEY=
# Default From header for outgoing transactional emails
EMAIL_FROM="Freshy.lk <orders@freshy.lk>"
# Store administrator email address for receiving new order alerts
OWNER_NOTIFY_EMAIL=owner@freshy.lk
# Store administrator mobile phone number for SMS notifications
OWNER_NOTIFY_PHONE=+94771234567
# Public WhatsApp contact phone number (without + symbol)
NEXT_PUBLIC_WHATSAPP_NUMBER=94771234567

# Security & Distributed Rate Limiting (Upstash Redis)
# Upstash Redis REST API endpoint URL
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST API authentication bearer token
UPSTASH_REDIS_REST_TOKEN=
# Cloudflare Turnstile bot protection public site key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Cloudflare Turnstile bot protection server secret key
TURNSTILE_SECRET_KEY=

# Monitoring & Analytics
# Sentry error tracking server DSN
SENTRY_DSN=
# Sentry error tracking client DSN
NEXT_PUBLIC_SENTRY_DSN=
# Sentry API authentication token for source maps upload
SENTRY_AUTH_TOKEN=
# Google Analytics 4 Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Scheduled Cron Jobs Security
# Secret Bearer token required in Authorization header for calls to /api/cron/*
CRON_SECRET=dev_cron_secret_123456
